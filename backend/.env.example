# Copy to backend/.env. This file contains examples, never production secrets.
NODE_ENV=development
PORT=5000
# Fill with the local development URI from README (database: hostelfix).
MONGODB_URI=
# Separate local test URI from README (database: hostelfix_test); never Atlas.
# Required in NODE_ENV=test; the database layer never falls back to MONGODB_URI.
# Backend tests use explicit local fixtures and do not load this env file.
TEST_MONGODB_URI=
# Set a locally generated random secret with at least 32 bytes; no default secret.
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000
# Set an absolute persistent storage path on your machine.
UPLOAD_DIR=
# Empty means no Domain attribute (host-only cookie).
COOKIE_DOMAIN=
# Localhost HTTP only. Production requires true and an HTTPS frontend origin.
COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRY=600
REFRESH_TOKEN_EXPIRY=604800
BCRYPT_ROUNDS=12
LOG_LEVEL=info
# CORS methods, CSRF header, cookie attributes, JSON/upload limits and rate
# policies are fixed by the PRD in src/config/policy.js; no extra secrets.
