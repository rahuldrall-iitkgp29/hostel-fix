{
  "name": "@hostelfix/backend",
  "version": "1.0.0",
  "private": true,
  "description": "HostelFix Express API",
  "type": "commonjs",
  "main": "src/app.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext js src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:ensure-indexes": "node scripts/ensure-indexes.js",
    "seed": "node seeds/index.js",
    "seed:reset": "node seeds/reset.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
